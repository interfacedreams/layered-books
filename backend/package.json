{
  "name": "aperture-backend",
  "version": "1.0.0",
  "description": "Backend service for Aperture reading platform",
  "type": "module",
  "scripts": {
    "dev": "bun --hot --env-file=.env src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir ./dist --target bun",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "epub": "^1.2.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "hono": "^4.8.5",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "typescript": "^5.6.3",
    "@types/bun": "latest"
  },
  "module": "src/index.ts",
  "private": true
}
