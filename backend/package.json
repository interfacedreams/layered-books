{
  "name": "aperture-backend",
  "version": "1.0.0",
  "description": "Backend service for Aperture reading platform",
  "type": "module",
  "scripts": {
    "dev": "bun --hot --env-file=.env src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir ./dist --target bun",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/openai": "^1.3.23",
    "@google/generative-ai": "^0.24.1",
    "@openrouter/ai-sdk-provider": "^1.0.0-beta.1",
    "@supabase/supabase-js": "^2.45.4",
    "@types/unorm": "^1.3.31",
    "ai": "^4.3.19",
    "cheerio": "^1.1.0",
    "cors": "^2.8.5",
    "epub": "^1.2.0",
    "epubjs": "^0.3.93",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "hono": "^4.8.5",
    "multer": "^1.4.5-lts.1",
    "openai": "^5.10.1",
    "supabase": "^2.31.4",
    "unorm": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "typescript": "^5.6.3"
  },
  "module": "src/index.ts",
  "private": true
}
