{
  "name": "aperture-backend",
  "version": "1.0.0",
  "description": "Backend service for Aperture reading platform",
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=.env src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir ./dist --target bun",
    "test": "bun test --test-dir tests/unit",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4",
    "@ai-sdk/openai": "^4",
    "@types/unorm": "^1.3.31",
    "ai": "^7",
    "cheerio": "^1.2",
    "drizzle-orm": "^0.45",
    "epub": "^1.2.0",
    "hono": "^4.13",
    "postgres": "^3.4.7",
    "unorm": "^1.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9"
  },
  "module": "src/index.ts",
  "private": true
}
