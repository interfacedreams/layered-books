{
  "name": "aperture-backend",
  "version": "1.0.0",
  "description": "Backend service for Aperture reading platform",
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=.env src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir ./dist --target bun",
    "test": "bun test --test-dir tests/unit",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.28",
    "@ai-sdk/fireworks": "^0.2.16",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/openai": "^1.3.23",
    "@google/generative-ai": "^0.24.1",
    "@openrouter/ai-sdk-provider": "^1.0.0-beta.1",
    "@types/unorm": "^1.3.31",
    "ai": "^6.0.57",
    "cheerio": "^1.1.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.3",
    "epub": "^1.2.0",
    "epubjs": "^0.3.93",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "hono": "^4.8.5",
    "multer": "^1.4.5-lts.1",
    "openai": "^5.10.1",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "unorm": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.6.3"
  },
  "module": "src/index.ts",
  "private": true
}
